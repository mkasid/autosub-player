<?xml version="1.0" encoding="utf-8"?>
<!-- High-visibility highlight for Fire TV D-pad navigation.
     Driven by the explicit button-mode state machine (view "selected"
     state), NOT the Android focus system — so the highlight can never
     disagree with where the D-pad scheme says focus is. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6D00" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E65100" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3A3A3A" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#777777" />
        </shape>
    </item>
</selector>
